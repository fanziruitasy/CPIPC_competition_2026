# 百炼 API Key。不要把真实 Key 提交到仓库。
DASHSCOPE_API_KEY=your-bailian-api-key

# bailian：使用百炼完成未显式指定的文件和 Sheet 召回。
# off：关闭百炼；此时未提供文件名或 Sheet 名的问题会明确报错。
RAG_VECTOR_PROVIDER=bailian

# 百炼 OpenAI 兼容接口与 embedding 模型占位。
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_EMBEDDING_MODEL=text-embedding-v4

# 可选参数；不填 dimensions 时使用模型默认维度。
# BAILIAN_EMBEDDING_DIMENSIONS=1024
BAILIAN_EMBEDDING_BATCH_SIZE=10
BAILIAN_EMBEDDING_TIMEOUT=30
BAILIAN_EMBEDDING_MAX_CHARS=6000

# 文件和 Sheet 向量召回置信度闸门。
BAILIAN_FILE_MIN_SCORE=0.20
BAILIAN_FILE_MIN_MARGIN=0.02
BAILIAN_SHEET_MIN_SCORE=0.20
BAILIAN_SHEET_MIN_MARGIN=0.02

# 原有 Qwen 查询规划器仍复用 DASHSCOPE_API_KEY。
QWEN_MODEL=qwen3.7-plus

# 检索后受证据约束的回答生成。默认复用 QWEN_MODEL，也可单独指定。
RAG_USE_LLM_ANSWERER=true
# QWEN_ANSWER_MODEL=qwen3.7-plus
QWEN_ANSWER_TIMEOUT=60
QWEN_MAX_EVIDENCE_CHARS=16000
